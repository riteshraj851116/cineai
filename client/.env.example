# CineAI Client Environment Configuration
# For local development with Vite dev server proxying to localhost:5000, leave blank or use defaults:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# For production on Vercel:
# Set VITE_API_URL to your deployed backend URL + /api (e.g. https://your-backend.onrender.com/api)
# Set VITE_SOCKET_URL to your deployed backend URL (e.g. https://your-backend.onrender.com)
