    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "keywords": [
    "mern",
    "react",
    "vite",
    "socket-io",
    "ai",
    "booking",
    "cinema"
